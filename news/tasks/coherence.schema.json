{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stories"],
  "properties": {
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story_index", "verdict", "reason"],
        "properties": {
          "story_index": {"type": "integer", "minimum": 0, "maximum": 49},
          "verdict": {"type": "string", "enum": ["supported", "unsupported", "uncertain"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1200}
        }
      }
    }
  }
}
