{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stories"
  ],
  "properties": {
    "stories": {
      "type": "array",
      "minItems": 0,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story_id",
              "title",
              "events"
            ],
            "properties": {
              "story_id": {
                "type": "null"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/new_event"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story_id",
              "title",
              "events"
            ],
            "properties": {
              "story_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/continuing_event"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "quote"
      ],
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "new_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "title",
        "identity_uncertain",
        "continuity_evidence",
        "observations"
      ],
      "properties": {
        "event_id": {
          "type": "null"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "identity_uncertain": {
          "type": "boolean"
        },
        "continuity_evidence": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/quote"
          },
          "maxItems": 0
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "continuing_event": {
      "anyOf": [
        {
          "$ref": "#/$defs/new_event_in_story"
        },
        {
          "$ref": "#/$defs/existing_event"
        }
      ]
    },
    "new_event_in_story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "title",
        "identity_uncertain",
        "continuity_evidence",
        "observations"
      ],
      "properties": {
        "event_id": {
          "type": "null"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "identity_uncertain": {
          "type": "boolean"
        },
        "continuity_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "existing_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "title",
        "identity_uncertain",
        "continuity_evidence",
        "observations"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "identity_uncertain": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "continuity_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "summary",
        "unresolved",
        "article_ids",
        "evidence",
        "comparison_evidence"
      ],
      "properties": {
        "change": {
          "type": "string",
          "enum": [
            "new_development",
            "additional_reporting",
            "correction",
            "disagreement",
            "unclear"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "unresolved": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 400
        },
        "article_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "comparison_evidence": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/quote"
          }
        }
      }
    }
  }
}
